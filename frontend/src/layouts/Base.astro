---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title} | Little Room</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">Little Room</a>
        <ul>
          <li><a href="/">Studio</a></li>
          <li><a href="/book">Book</a></li>
          <li><a href="/account" id="nav-account">Account</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Little Room</p>
    </footer>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: system-ui, sans-serif;
    color: #1a1a1a;
    background: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  a { color: inherit; text-decoration: none; }

  header {
    border-bottom: 1px solid #e5e5e5;
    padding: 0 2rem;
  }

  nav {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  nav .logo { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.02em; }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    font-size: 0.9rem;
  }

  nav ul a:hover { text-decoration: underline; }

  main {
    flex: 1;
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    padding: 3rem 2rem;
  }

  footer {
    border-top: 1px solid #e5e5e5;
    padding: 1.5rem 2rem;
    text-align: center;
    font-size: 0.85rem;
    color: #666;
  }
</style>
