---
import type { Room } from '../lib/api';

interface Props {
  room: Room;
}
const { room } = Astro.props;
---

<article class="room-card">
  <div class="room-image">
    <span class="placeholder">📷</span>
  </div>
  <div class="room-body">
    <h3>{room.name}</h3>
    {room.size_sqm && <p class="meta">{room.size_sqm} m²</p>}
    {room.description && <p class="description">{room.description}</p>}
    {room.equipment.length > 0 && (
      <ul class="equipment">
        {room.equipment.map(e => <li>{e.name}</li>)}
      </ul>
    )}
    <div class="footer">
      <span class="rate">£{room.hourly_rate} / hr</span>
      <a href="/book" class="btn-book">Book</a>
    </div>
  </div>
</article>

<style>
  .room-card {
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .room-image {
    background: #f0f0f0;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: #bbb;
  }

  .room-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  h3 { font-size: 1.1rem; letter-spacing: -0.02em; }

  .meta { font-size: 0.85rem; color: #888; }

  .description { font-size: 0.9rem; color: #555; line-height: 1.5; }

  .equipment {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .equipment li {
    font-size: 0.8rem;
    color: #666;
    padding-left: 0.75rem;
    position: relative;
  }

  .equipment li::before {
    content: '–';
    position: absolute;
    left: 0;
  }

  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid #f0f0f0;
  }

  .rate { font-weight: 600; font-size: 0.95rem; }

  .btn-book {
    background: #1a1a1a;
    color: #fff;
    padding: 0.4rem 1rem;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .btn-book:hover { background: #333; }
</style>
