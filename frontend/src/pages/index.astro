---
import Base from '../layouts/Base.astro';
import RoomsGrid from '../islands/RoomsGrid.svelte';
---

<Base title="Studio">
  <section class="hero">
    <h1>Little Room</h1>
    <p>Big rehearsal spaces with little room creative energy.</p>
    <a href="/book" class="btn">Book a room</a>
  </section>

  <section class="about">
    <h2>The Studio</h2>
    <p>
      little room is a musician-run rehearsal space with several fully equipped rooms available for hourly hire.
      Unlimited tea and coffee to fuel your jams, and helpful staff
      on hand should anything come up.<br /><br />
      Drop us an email if you have any questions or special requirements :)
    </p>
  </section>

  <section class="rooms">
    <h2>Rooms</h2>
    <RoomsGrid client:load />
  </section>

  <section class="info">
    <div class="info-block">
      <h2>Find Us</h2>
      <address>
        45 Rocky Grove<br />
        Bluewood<br />
        AB1 2CD
      </address>
    </div>
    <div class="info-block">
      <h2>Contact</h2>
      <p><a href="mailto:hello@littleroom.example">hello@littleroom.example</a></p>
    </div>
  </section>
</Base>

<style>
  .hero {
    text-align: center;
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 3.5rem;
  }

  .hero h1 {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 3.7rem;
    text-transform: lowercase;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .hero p {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: 1.2rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-block;
    background: var(--accent);
    color: var(--accent-fg);
    padding: 0.75rem 1.75rem;
    font-size: 0.97rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.15s;
    border: 1px solid var(--accent);
  }
  .btn:hover { background: var(--accent-hover); border-color: var(--accent-hover); }

  section { margin-bottom: 4rem; }

  h2 {
    font-family: var(--font-ui);
    font-weight: 300;
    font-size: 1.4rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }


  .info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    padding: 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .info h2 { margin-bottom: 0.75rem; }
  address {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-style: normal;
    line-height: 1.9;
    color: var(--text-muted);
    font-size: 1rem;
  }

  .about p, .info p {
    font-family: 'Barlow', sans-serif;
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

</style>
